// VeriFace Edge — Prisma schema
// Production-grade biometric authentication with strict tenant isolation.
// All biometric templates are stored as Pedersen commitments + encrypted vectors;
// raw facial images NEVER touch the database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Enterprise tenant. Each tenant has isolated encryption keys (KMS CMK)
/// and a dedicated vector collection. Tenant scoping is enforced at the
/// application layer via the `requireTenant` middleware.
model Tenant {
  id            String   @id @default(cuid())
  name          String
  /// Ed25519 public key (hex) used to verify SDK-signed JWTs.
  /// Rotated annually; previous keys retained for verification window.
  signingPubKey String
  /// HMAC secret (hex) for webhook payload signing.
  webhookSecret String
  /// KMS key identifier for tenant DEK (Data Encryption Key).
  /// Used for crypto-erasure on Right-to-be-Forgotten requests.
  kmsKeyId      String
  /// Liveness threshold override (0.0–1.0). NULL = use global default (0.78).
  livenessThreshold Float?
  /// Maximum allowed session age in seconds.
  maxSessionAgeSec Int     @default(60)
  /// Webhook endpoint URL. NULL = no webhooks.
  webhookUrl    String?
  /// Active flag. Soft-deleted tenants cannot authenticate.
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users       User[]
  templates   BiometricTemplate[]
  sessions    Session[]
  auditLogs   AuditLog[]
  webhooks    WebhookDelivery[]

  @@index([active])
}

/// End-user identity. The `externalUserId` is opaque to VeriFace —
/// it is the enterprise client's user identifier (e.g., their UUID).
/// VeriFace NEVER stores PII (name, email, photo) — only the
/// cryptographic commitment to the biometric template.
model User {
  id             String   @id @default(cuid())
  tenantId       String
  externalUserId String
  /// Revocation token (hex BLAKE3 hash). Issued at enrollment; presented
  /// by the user to revoke their template under GDPR Art. 17.
  revocationToken String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templates  BiometricTemplate[]

  @@unique([tenantId, externalUserId])
  @@index([tenantId])
}

/// Biometric template. Stores ONLY:
///   - Pedersen commitment (for ZK proof verification)
///   - Encrypted embedding (AES-256-GCM with tenant DEK)
///   - KMS key reference (for crypto-erasure)
/// NEVER stores raw embedding, image, or video.
model BiometricTemplate {
  id              String   @id @default(cuid())
  userId          String
  tenantId        String
  /// Pedersen commitment: SHA-256(embedding || nonce) — used as ZK public input.
  commitment      String
  /// Encrypted embedding (hex). AES-256-GCM with tenant DEK.
  /// Even if database is compromised, plaintext is unrecoverable
  /// without KMS access.
  encryptedVector String
  /// Initialization vector for AES-GCM (hex).
  iv              String
  /// Auth tag for AES-GCM (hex).
  authTag         String
  /// L2 norm of original embedding (for sanity check on ZK proofs).
  norm            Float
  /// Template variant: 'standard' (1 capture) or 'high_security' (3 captures).
  variant         String   @default("standard")
  /// Model version when template was created (for migration support).
  modelVersion    String
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
}

/// Authentication session. Ephemeral — used to coordinate the
/// challenge-response flow between SDK and backend.
model Session {
  id              String   @id @default(cuid())
  tenantId        String
  /// Random nonce (hex) generated by backend. SDK must include in ZK proof.
  challenge       String
  /// Backend's ephemeral X25519 public key (hex) for session ECDH.
  backendPubKey   String
  /// SDK's ephemeral X25519 public key (hex), set on /verify.
  sdkPubKey       String?
  /// State machine: 'pending' → 'verifying' → 'success' | 'failed' | 'expired'
  state           String   @default("pending")
  /// Flow type: 'enroll' | 'authenticate'
  flow            String
  /// Optional: target user ID for authentication flow.
  targetUserId    String?
  /// IP address of SDK (for fraud detection).
  clientIp        String?
  /// User-Agent (truncated to 256 chars).
  userAgent       String?
  /// Verification result metadata (JSON).
  result          String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, state])
  @@index([expiresAt])
}

/// Hash-chained audit log. Append-only — entries are linked via
/// SHA-256(prev_hash || current_payload). Tamper-evident: any
/// modification breaks the chain and is detectable by re-walking.
model AuditLog {
  id              String   @id @default(cuid())
  tenantId        String
  /// Event type: 'session.init' | 'auth.success' | 'auth.failure' |
  /// 'enroll.success' | 'template.revoked' | 'key.rotated' | ...
  eventType       String
  /// Event payload (JSON).
  payload         String
  /// SHA-256(prev_hash || payload || ts) — tamper-evident chain.
  prevHash        String
  thisHash        String
  /// Sequential chain counter per tenant.
  chainIndex      Int
  /// IP address of the actor.
  actorIp         String?
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, chainIndex])
}

/// Webhook delivery queue. Retries with exponential backoff.
model WebhookDelivery {
  id              String   @id @default(cuid())
  tenantId        String
  /// Event type (matches AuditLog.eventType).
  eventType       String
  /// Payload (JSON).
  payload         String
  /// HMAC-SHA256 signature (hex) computed with tenant.webhookSecret.
  signature       String
  /// Delivery state: 'pending' | 'delivered' | 'failed' | 'dead_letter'
  state           String   @default("pending")
  /// Attempt count.
  attempts        Int      @default(0)
  /// Next retry time (for exponential backoff).
  nextRetryAt     DateTime?
  /// Last HTTP response code.
  lastResponseCode Int?
  /// Last error message.
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, state])
  @@index([nextRetryAt])
}

/// Server-side session JWT blacklist (for revocation before expiry).
model RevokedToken {
  id              String   @id @default(cuid())
  jti             String   @unique
  tenantId        String
  reason          String
  revokedAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([tenantId])
  @@index([expiresAt])
}
