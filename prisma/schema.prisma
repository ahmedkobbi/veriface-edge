// VeriFace Edge — Prisma schema (Extended)
// Production-grade biometric authentication with strict tenant isolation,
// API key auth, FIDO2/WebAuthn hybrid flow, rate limiting, and audit trail.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Enterprise tenant. Each tenant has isolated encryption keys (KMS CMK)
/// and a dedicated vector collection. Tenant scoping is enforced at the
/// application layer via the `requireTenant` middleware.
model Tenant {
  id            String   @id @default(cuid())
  name          String
  /// Ed25519 public key (hex) used to verify SDK-signed JWTs.
  /// Legacy — being migrated to ML-DSA-87 (post-quantum).
  signingPubKey String
  /// ML-DSA-87 (Dilithium5) public key (hex, 5184 chars) — post-quantum.
  /// NULL = tenant hasn't migrated to post-quantum signatures yet.
  pqSigningPubKey String?
  /// HMAC secret (hex) for webhook payload signing.
  webhookSecret String
  /// KMS key identifier for tenant DEK (Data Encryption Key).
  kmsKeyId      String
  /// Liveness threshold override (0.0–1.0). NULL = use global default (0.78).
  livenessThreshold Float?
  /// Maximum allowed session age in seconds.
  maxSessionAgeSec Int     @default(60)
  /// Webhook endpoint URL. NULL = no webhooks.
  webhookUrl    String?
  /// Active flag. Soft-deleted tenants cannot authenticate.
  active        Boolean  @default(true)
  /// Maximum auths per minute per tenant (rate limit) — per-minute floor.
  /// Overridden by planTier (Developer=10, Growth=100, Enterprise=1000).
  rateLimitPerMin Int    @default(60)
  /// Pricing tier: 'developer' (1K/mo) | 'growth' (100K/mo) | 'enterprise' (unlimited).
  /// Drives monthly API quota, per-minute limit floor, feature flags, and billing alerts.
  planTier      String   @default("developer")
  /// Spending limit (USD) per month — billing alert fires when reached.
  spendingLimitUsd Float  @default(100)
  /// Alert when monthly usage crosses this percentage of monthly limit (0–100).
  alertThresholdPct Int   @default(80)
  /// Whether to require ZK proofs (vs Pedersen commitment fallback).
  /// true = require Groth16 ZK proof (post-quantum, zero-knowledge)
  /// false = accept legacy Pedersen commitment (migration mode)
  requireZkProof Boolean @default(false)
  /// Signature verification mode:
  /// 'hybrid-any' = accept Ed25519 OR ML-DSA-87 (migration phase 1)
  /// 'hybrid-all' = require BOTH Ed25519 AND ML-DSA-87 (migration phase 2)
  /// 'mldsa87-only' = require ML-DSA-87 only (post-quantum, Ed25519 deprecated)
  /// 'ed25519-only' = legacy (no post-quantum)
  signatureMode String   @default("hybrid-any")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users       User[]
  templates   BiometricTemplate[]
  sessions    Session[]
  auditLogs   AuditLog[]
  webhooks    WebhookDelivery[]
  apiKeys     ApiKey[]
  webauthnCreds WebAuthnCredential[]
  platformUsers PlatformUser[]
  samlConfig   SamlConfig?
  emailLogs   EmailLog[]
  notificationPrefs NotificationPreference[]
  apiUsageCounters ApiUsageCounter[]
  experiments Experiment[]
  experimentAssignments ExperimentAssignment[]
  experimentOutcomes ExperimentOutcome[]
  subscription   Subscription?
  invoices       Invoice[]
  payments       Payment[]

  @@index([active])
  @@index([planTier])
}

/// Per-tenant monthly API usage counter (for plan-tier rate limiting).
/// Key: `${tenantId}:${YYYY-MM}`. Reset on month rollover.
model ApiUsageCounter {
  id              String   @id @default(cuid())
  tenantId        String
  /// Year-month key, e.g., "2026-08". One row per tenant per month.
  monthKey        String
  /// Count of billable API calls this month (auth.success, enroll.success, etc.).
  count           Int      @default(0)
  /// Whether the 80% alert was already fired (prevents duplicate emails).
  thresholdAlertSent Boolean @default(false)
  /// Whether the 100% limit alert was already fired.
  limitAlertSent  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, monthKey])
  @@index([tenantId, monthKey])
  @@index([monthKey])
}

/// Email notification log — every sent email is recorded here.
/// Acts as the queue (state='pending') and the history (state='sent'/'failed').
model EmailLog {
  id              String   @id @default(cuid())
  tenantId        String
  /// Recipient email address.
  toAddress       String
  /// Template key: 'auth.new_device' | 'auth.failed_login' | 'billing.threshold' | etc.
  template        String
  /// Rendered subject line.
  subject         String
  /// Rendered HTML body (stored for audit trail, encrypted at rest in production).
  bodyHtml        String
  /// State machine: 'pending' → 'sent' | 'failed' | 'suppressed'
  state           String   @default("pending")
  /// Attempt count (for retry tracking).
  attempts        Int      @default(0)
  /// Max attempts before dead-lettering (default 4 = 1 initial + 3 retries).
  maxAttempts     Int      @default(4)
  /// Next retry time (exponential backoff: 1m, 10m, 1h).
  nextRetryAt     DateTime?
  /// Last SMTP response code (250, 421, 550, etc.).
  lastResponseCode Int?
  /// Last error message (truncated, PII-redacted).
  lastError       String?
  /// Dedup key — if set, only one email per (tenantId, dedupKey, 10-min window) is sent.
  dedupKey        String?
  /// Idempotency: SHA-256 of (tenantId | template | dedupKey | windowStart).
  idempotencyKey  String?
  sentAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, state])
  @@index([tenantId, template, createdAt])
  @@index([nextRetryAt])
  @@index([toAddress])
  @@unique([idempotencyKey])
}

/// Per-user notification preferences. Overrides tenant-wide defaults.
model NotificationPreference {
  id              String   @id @default(cuid())
  tenantId        String
  /// PlatformUser ID this preference belongs to.
  userId          String
  /// Auth alerts (new device, password change, 2FA change).
  authAlerts      Boolean  @default(true)
  /// Security alerts (injection detected, brute force, suspicious activity).
  securityAlerts  Boolean  @default(true)
  /// Billing alerts (threshold reached, spending limit hit, quota exhausted).
  billingAlerts   Boolean  @default(true)
  /// Product updates (new features, changelog, maintenance).
  productUpdates  Boolean  @default(false)
  /// Weekly usage digest.
  weeklyDigest    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([tenantId])
}

/// API keys for tenant authentication. Each tenant can have multiple keys
/// (for rotation, separate environments, etc.). Keys are prefixed with
/// `vf_live_` or `vf_test_` and SHA-256 hashed before storage — the
/// plaintext is shown ONCE at creation time.
model ApiKey {
  id              String   @id @default(cuid())
  tenantId        String
  /// SHA-256 hash of the API key (we never store plaintext).
  keyHash         String   @unique
  /// Prefix + first 8 chars of the key (for display: "vf_live_abc123…")
  keyPrefix       String
  /// Human-readable label (e.g., "Production", "Staging").
  label           String
  /// Scopes: 'tenant:admin' | 'session:init' | 'session:verify' | 'audit:read' | '*'
  scopes          String   @default("*")
  /// Last 4 characters of the key (for identification without revealing).
  lastFour        String
  /// Active flag for revocation.
  active          Boolean  @default(true)
  /// Expiration timestamp (null = no expiry).
  expiresAt       DateTime?
  /// Last used timestamp.
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  revokedAt       DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@index([keyHash])
}

/// End-user identity. The `externalUserId` is opaque to VeriFace —
/// it is the enterprise client's user identifier (e.g., their UUID).
model User {
  id             String   @id @default(cuid())
  tenantId       String
  externalUserId String
  /// Revocation token (hex BLAKE3 hash). Issued at enrollment; presented
  /// by the user to revoke their template under GDPR Art. 17.
  revocationToken String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templates  BiometricTemplate[]
  webauthnCreds WebAuthnCredential[]

  @@unique([tenantId, externalUserId])
  @@index([tenantId])
}

/// Biometric template. Stores ONLY:
///   - Pedersen commitment (for ZK proof verification)
///   - Encrypted embedding (AES-256-GCM with tenant DEK)
///   - KMS key reference (for crypto-erasure)
/// NEVER stores raw embedding, image, or video.
model BiometricTemplate {
  id              String   @id @default(cuid())
  userId          String
  tenantId        String
  /// Pedersen commitment: SHA-256(embedding || nonce) — used as ZK public input.
  commitment      String
  /// Encrypted embedding (hex). AES-256-GCM with tenant DEK.
  encryptedVector String
  /// Initialization vector for AES-GCM (hex).
  iv              String
  /// Auth tag for AES-GCM (hex).
  authTag         String
  /// L2 norm of original embedding (for sanity check on ZK proofs).
  norm            Float
  /// Template variant: 'standard' (1 capture) or 'high_security' (3 captures).
  variant         String   @default("standard")
  /// Model version when template was created (for migration support).
  modelVersion    String
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
}

/// Authentication session. Ephemeral — used to coordinate the
/// challenge-response flow between SDK and backend.
model Session {
  id              String   @id @default(cuid())
  tenantId        String
  /// Random nonce (hex) generated by backend. SDK must include in ZK proof.
  challenge       String
  /// Backend's ephemeral X25519 public key (hex) for session ECDH.
  backendPubKey   String
  /// SDK's ephemeral X25519 public key (hex), set on /verify.
  sdkPubKey       String?
  /// State machine: 'pending' → 'verifying' → 'success' | 'failed' | 'expired'
  state           String   @default("pending")
  /// Flow type: 'enroll' | 'authenticate' | 'webauthn_enroll' | 'webauthn_verify'
  flow            String
  /// Optional: target user ID for authentication flow.
  targetUserId    String?
  /// IP address of SDK (for fraud detection).
  clientIp        String?
  /// User-Agent (truncated to 256 chars).
  userAgent       String?
  /// Verification result metadata (JSON).
  result          String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, state])
  @@index([expiresAt])
}

/// Hash-chained audit log. Append-only — entries are linked via
/// SHA-256(prev_hash || current_payload). Tamper-evident: any
/// modification breaks the chain and is detectable by re-walking.
model AuditLog {
  id              String   @id @default(cuid())
  tenantId        String
  /// Event type: 'session.init' | 'auth.success' | 'auth.failure' |
  /// 'enroll.success' | 'template.revoked' | 'key.rotated' | 'api_key.created' | ...
  eventType       String
  /// Event payload (JSON).
  payload         String
  /// SHA-256(prev_hash || payload || ts) — tamper-evident chain.
  prevHash        String
  thisHash        String
  /// Sequential chain counter per tenant.
  chainIndex      Int
  /// IP address of the actor.
  actorIp         String?
  /// API key ID used for the action (if applicable).
  apiKeyId        String?
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, chainIndex])
  @@index([eventType])
  @@unique([tenantId, chainIndex])
}

/// Webhook delivery queue. Retries with exponential backoff.
model WebhookDelivery {
  id              String   @id @default(cuid())
  tenantId        String
  /// Event type (matches AuditLog.eventType).
  eventType       String
  /// Payload (JSON).
  payload         String
  /// HMAC-SHA256 signature (hex) computed with tenant.webhookSecret.
  signature       String
  /// Delivery state: 'pending' | 'delivered' | 'failed' | 'dead_letter'
  state           String   @default("pending")
  /// Attempt count.
  attempts        Int      @default(0)
  /// Next retry time (for exponential backoff).
  nextRetryAt     DateTime?
  /// Last HTTP response code.
  lastResponseCode Int?
  /// Last error message.
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, state])
  @@index([nextRetryAt])
}

/// Server-side session JWT blacklist (for revocation before expiry).
model RevokedToken {
  id              String   @id @default(cuid())
  jti             String   @unique
  tenantId        String
  reason          String
  revokedAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([tenantId])
  @@index([expiresAt])
}

/// FIDO2 / WebAuthn credentials for hybrid authentication.
/// Pairs a facial template with a hardware authenticator (YubiKey,
/// Touch ID, Windows Hello) for step-up authentication.
model WebAuthnCredential {
  id              String   @id @default(cuid())
  userId          String
  tenantId        String
  /// WebAuthn credential ID (base64url).
  credentialId    String   @unique
  /// Public key (CBOR-encoded, hex).
  publicKey       String
  /// Counter for clone detection (incremented per use).
  counter         Int      @default(0)
  /// Transport hints (USB, NFC, BLE, internal, hybrid).
  transports      String
  /// AAGUID (authenticator model identifier).
  aaguid          String
  /// Whether the credential is platform-bound (Touch ID) or roaming (YubiKey).
  deviceType      String   @default("roaming")
  /// Whether the credential was backed up (sync passkey).
  backedUp        Boolean  @default(false)
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

/// Platform users — customers who sign up for VeriFace Edge accounts.
/// Separate from biometric users (User model) — these are the enterprise
/// admins who manage tenants, API keys, and billing.
model PlatformUser {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  role          String   @default("user") // "user" | "admin"
  emailVerified Boolean  @default(false)
  tenantId      String?  // owned tenant (1 user → 1 tenant for now)
  lastLoginAt   DateTime?
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String?  // encrypted TOTP secret (base32)
  twoFactorBackupCodes String? // JSON array of hashed backup codes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  emailVerifTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@index([tenantId])
}

/// Email verification tokens — single-use, expire after 24h.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

/// Password reset tokens — single-use, expire after 1h.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

/// SAML SSO configuration per tenant.
/// Allows enterprise customers to authenticate via their IdP (Okta, Azure AD, OneLogin).
model SamlConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  /// IdP entity ID (usually a URL, e.g., https://yourorg.okta.com/saml/metadata)
  idpEntityId     String
  /// IdP SSO URL (where we redirect users to authenticate)
  idpSsoUrl       String
  /// IdP x509 certificate (PEM format, used to verify SAML assertions)
  idpCertificate  String
  /// SP entity ID (our entity ID, e.g., https://api.veriface.io/saml/metadata)
  spEntityId      String
  /// SP ACS URL (our Assertion Consumer Service URL)
  spAcsUrl        String
  /// Attribute mapping: which SAML attribute contains the email
  emailAttribute  String   @default("email")
  /// Attribute mapping: which SAML attribute contains the name
  nameAttribute   String   @default("name")
  /// Whether SAML SSO is enabled for this tenant
  enabled         Boolean  @default(false)
  /// Auto-provision users on first SAML login
  autoProvision   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Rate limit bucket (per tenant + IP). Reset every minute.
/// Stored in DB for multi-instance deployments; in-memory cache in front.
model RateLimitBucket {
  id              String   @id @default(cuid())
  /// Composite key: `${tenantId}:${ip}` or `${tenantId}:global`
  bucketKey       String   @unique
  /// Window start timestamp.
  windowStart     DateTime
  /// Request count in current window.
  count           Int      @default(0)

  @@index([bucketKey, windowStart])
}

/// Consent records (GDPR Art. 7). Every biometric processing requires
/// explicit, time-stamped consent. Withdrawing consent triggers
/// template deletion (Right to be Forgotten).
model ConsentRecord {
  id              String   @id @default(cuid())
  userId          String
  tenantId        String
  /// Purpose of processing: 'authentication' | 'enrollment' | 'age_verification'
  purpose         String
  /// Whether consent was given or withdrawn.
  granted         Boolean
  /// IP address of the user at consent time.
  ip              String?
  /// User agent string.
  userAgent       String?
  /// Optional: consent flow version (for A/B testing consent UX).
  flowVersion     String?
  createdAt       DateTime @default(now())

  @@index([tenantId, userId, purpose])
  @@index([tenantId, createdAt])
}

/// SDK error telemetry — opt-in, anonymous error reports from the browser SDK.
/// NO PII, NO face data, NO embeddings, NO frames. Only error codes + environment.
///
/// Privacy contract (enforced by ingestion endpoint):
///   - telemetryOptIn MUST be true (sent by SDK after explicit user consent)
///   - tenantId is hashed before storage (so we can group without identifying)
///   - errorPayload is Zod-validated to reject any field not in the allowlist
///   - all string fields are length-capped (256 chars max)
///   - ingestion is rate-limited per IP (10/min) to prevent abuse
model SdkErrorEvent {
  id              String   @id @default(cuid())
  /// SHA-256(tenantId) — allows grouping by tenant without storing the ID.
  tenantIdHash    String
  /// SDK semver (e.g., "1.2.3").
  sdkVersion      String
  /// Error code from the VeriFaceErrorCode union (NO_LIVENESS, CAMERA_DENIED, etc.).
  errorCode       String
  /// Error severity: 'fatal' | 'error' | 'warning'.
  severity        String   @default("error")
  /// Stage where the error occurred: 'init' | 'camera' | 'capture' | 'liveness' | 'anti_injection' | 'crypto' | 'verify' | 'network'.
  stage           String
  /// Truncated error message (max 256 chars, PII-redacted by SDK before send).
  errorMessage    String
  /// Anonymous environment fingerprint (browser family + OS family, NO UA string).
  browserFamily   String
  osFamily        String
  /// Whether WebGPU was available.
  hasWebGPU       Boolean  @default(false)
  /// Whether the camera was granted.
  hasCamera       Boolean  @default(false)
  /// Session ID (if available — helps correlate with backend audit log).
  sessionId       String?
  /// Active experiment assignment (if any) — for A/B cohort analysis.
  experimentId    String?
  experimentVariant String?
  /// Anonymous client-side duration metrics (JSON, e.g., {captureMs: 1820, rppgMs: 1500}).
  metrics         String?
  createdAt       DateTime @default(now())

  @@index([tenantIdHash, createdAt])
  @@index([errorCode, createdAt])
  @@index([experimentId, experimentVariant])
}
/// A/B test experiment definition. One experiment per "variable" being tested.
/// E.g., liveness_threshold with variants [{name: 'control', value: 0.78}, {name: 'strict', value: 0.82}].
model Experiment {
  id              String   @id @default(cuid())
  tenantId        String
  /// Human-readable name (e.g., "Liveness threshold strictness Q3 2026").
  name            String
  /// What we're testing (e.g., 'liveness_threshold', 'capture_duration', 'rppg_window').
  variable        String
  /// Variants JSON: [{name: 'control', value: 0.78, weight: 50}, {name: 'strict', value: 0.82, weight: 50}].
  /// Weights sum to 100. Variant 'control' is required for analysis.
  variants        String
  /// Description / hypothesis (markdown).
  description     String?
  /// State: 'draft' | 'running' | 'paused' | 'completed'.
  state           String   @default("draft")
  /// Minimum sample size per variant before we compute significance (default 100).
  minSampleSize   Int      @default(100)
  /// Statistical significance threshold (default 0.05 = 95% confidence).
  significanceThreshold Float @default(0.05)
  /// When the experiment started (null if draft).
  startedAt       DateTime?
  /// When the experiment ended (null if running).
  endedAt          DateTime?
  /// Auto-stop when significance is reached (default true).
  autoStopOnSignificance Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments     ExperimentAssignment[]
  outcomes        ExperimentOutcome[]

  @@index([tenantId, state])
  @@index([tenantId, variable])
}

/// Per-(user × experiment) assignment. One row per user per experiment —
/// once assigned, the variant is sticky for the experiment's lifetime
/// (so the user sees consistent behavior across sessions).
model ExperimentAssignment {
  id              String   @id @default(cuid())
  tenantId        String
  experimentId    String
  /// Anonymous user bucket key (SHA-256 of externalUserId + tenant salt).
  /// Allows re-assigning the same variant to the same user across sessions
  /// without storing the user ID.
  userBucketKey   String
  /// Assigned variant name (e.g., 'control', 'strict').
  variant         String
  /// Resolved variant value at assignment time (e.g., 0.82 for liveness_threshold).
  variantValue    String
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  experiment      Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, userBucketKey])
  @@index([tenantId, experimentId])
  @@index([experimentId, variant])
}

/// Experiment outcome — recorded when an assigned user completes an auth/enroll flow.
/// Used to compute success rates per variant and statistical significance.
model ExperimentOutcome {
  id              String   @id @default(cuid())
  tenantId        String
  experimentId    String
  /// The assignment this outcome belongs to.
  assignmentId    String
  variant         String
  /// Outcome type: 'auth.success' | 'auth.failure' | 'enroll.success' | 'enroll.failure' | 'liveness.failed' | 'injection.detected'.
  outcome         String
  /// Liveness score at the time (for analysis).
  livenessScore   Float?
  /// Cosine similarity (for auth flows).
  cosineSimilarity Float?
  /// Time-to-complete in ms (from session.init to session.verify).
  durationMs      Int?
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  experiment      Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId, variant, outcome])
  @@index([assignmentId])
}

/// Stripe subscription — syncs with Stripe's subscription object.
model Subscription {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  /// Stripe Customer ID (cus_...).
  stripeCustomerId String?
  /// Stripe Subscription ID (sub_...).
  stripeSubscriptionId String?
  /// Stripe Price ID (price_...).
  stripePriceId   String?
  /// Stripe Checkout Session ID (cs_...) for the initial purchase.
  stripeCheckoutSessionId String?
  /// Plan tier: 'developer' | 'growth' | 'enterprise'.
  planTier        String   @default("developer")
  /// Status: 'incomplete' | 'active' | 'past_due' | 'canceled' | 'unpaid'.
  status          String   @default("incomplete")
  /// Billing interval: 'month' | 'year'.
  interval        String   @default("month")
  /// Current period start.
  currentPeriodStart DateTime?
  /// Current period end.
  currentPeriodEnd   DateTime?
  /// Cancel at period end (true = will cancel, false = active).
  cancelAtPeriodEnd Boolean @default(false)
  /// Canceled at (timestamp).
  canceledAt      DateTime?
  /// Trial end (if applicable).
  trialEnd        DateTime?
  /// Monthly spending limit (USD) — billing alert fires when reached.
  spendingLimitUsd Float  @default(100)
  /// Alert threshold percentage (0–100).
  alertThresholdPct Int   @default(80)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices        Invoice[]
  payments        Payment[]

  @@index([tenantId])
  @@index([stripeCustomerId])
  @@index([status])
}

/// Invoice — tracks each billing period's invoice.
model Invoice {
  id              String   @id @default(cuid())
  tenantId        String
  subscriptionId  String
  /// Stripe Invoice ID (in_...).
  stripeInvoiceId String?
  /// Invoice number (human-readable).
  number          String?
  /// Status: 'draft' | 'open' | 'paid' | 'uncollectible' | 'void'.
  status          String   @default("draft")
  /// Amount in cents (USD).
  amountDue       Int      @default(0)
  /// Amount paid in cents.
  amountPaid      Int      @default(0)
  /// Currency (3-letter ISO code).
  currency        String   @default("usd")
  /// Line items (JSON array).
  lineItems       String?
  /// Invoice PDF URL (from Stripe).
  invoicePdf      String?
  /// Hosted invoice URL (from Stripe).
  hostedInvoiceUrl String?
  /// Due date.
  dueDate         DateTime?
  /// Paid at.
  paidAt          DateTime?
  /// Period start.
  periodStart     DateTime?
  /// Period end.
  periodEnd       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments        Payment[]

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
}

/// Payment — individual payment transaction (Stripe or NowPayments).
model Payment {
  id              String   @id @default(cuid())
  tenantId        String
  subscriptionId  String?
  invoiceId       String?
  /// Payment provider: 'stripe' | 'nowpayments'.
  provider        String
  /// Provider transaction ID (Stripe: pi_..., NowPayments: UUID).
  providerPaymentId String?
  /// Provider charge ID (Stripe: ch_...).
  providerChargeId String?
  /// Amount in cents (USD) or smallest currency unit.
  amount          Int
  /// Currency (3-letter ISO code or crypto symbol).
  currency        String
  /// Status: 'pending' | 'succeeded' | 'failed' | 'refunded' | 'canceled'.
  status          String   @default("pending")
  /// Payment method: 'card' | 'usdc' | 'btc' | 'eth' | etc.
  paymentMethod   String?
  /// For crypto: the wallet address that paid.
  fromAddress     String?
  /// For crypto: the wallet address that received.
  toAddress       String?
  /// For crypto: transaction hash on the blockchain.
  txHash          String?
  /// For crypto: confirmations count.
  confirmations   Int?
  /// Refund amount (if partially refunded).
  refundedAmount  Int      @default(0)
  /// Failure reason (if failed).
  failureReason   String?
  /// Provider metadata (JSON).
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoice         Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([invoiceId])
  @@index([provider, status])
  @@index([providerPaymentId])
}

/// Processed webhook events — for idempotency.
/// Prevents duplicate processing when Stripe/NowPayments retry webhooks.
/// Stripe retries up to 16 times over 3 days; NowPayments retries for 24 hours.
/// Without this table, each retry would create duplicate invoice/payment records.
model WebhookEvent {
  id              String   @id @default(cuid())
  /// Provider: 'stripe' | 'nowpayments'.
  provider        String
  /// Provider's event ID (Stripe: evt_..., NowPayments: payment_id + status).
  eventId         String
  /// Event type (Stripe: checkout.session.completed, etc.).
  eventType       String?
  /// Whether the event was successfully processed.
  processed       Boolean  @default(false)
  /// Processing error (if failed).
  error           String?
  /// Provider's raw payload (JSON, for audit/debugging).
  payload         String?
  /// When the event was received.
  receivedAt      DateTime @default(now())
  /// When the event was processed.
  processedAt     DateTime?

  @@unique([provider, eventId])
  @@index([provider, processed])
  @@index([receivedAt])
}

/// Backup record — audit trail for all database backups.
model BackupRecord {
  id              String   @id @default(cuid())
  /// Backup ID (format: veriface-backup-YYYY-MM-DD-THHMMSSZ).
  backupId        String   @unique
  /// Backup type: 'sqlite' | 'postgres'.
  backupType      String
  /// Source database path or connection (redacted).
  source          String
  /// Encrypted backup file name.
  encryptedFile   String
  /// Encrypted file size in bytes.
  encryptedSizeBytes Int
  /// SHA-256 of the encrypted file.
  encryptedSha256 String
  /// Original (pre-encryption) file size in bytes.
  originalSizeBytes Int
  /// SHA-256 of the original file.
  originalSha256  String
  /// Encryption algorithm (always 'AES-256-GCM').
  encryptionAlgorithm String @default("AES-256-GCM")
  /// Encryption IV (hex, 24 chars = 12 bytes).
  iv              String
  /// S3 bucket (if uploaded).
  s3Bucket        String?
  /// S3 key (if uploaded).
  s3Key           String?
  /// S3 URI (if uploaded).
  s3Uri           String?
  /// Status: 'success' | 'failed'.
  status          String   @default("success")
  /// Error message (if failed).
  error           String?
  /// Host that created the backup.
  host            String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

/// Attribute credential — a signed claim about a user (e.g., "over 18", "employee").
/// The credential is stored as a Poseidon commitment (not plaintext).
/// ZK proofs can be generated against this commitment to prove the attribute
/// without revealing the underlying value.
model AttributeCredential {
  id              String   @id @default(cuid())
  tenantId        String
  /// User this credential belongs to (external user ID).
  externalUserId  String
  /// Attribute type: 'age' | 'employment' | 'rate_limit' | 'custom'.
  attributeType   String
  /// Poseidon commitment to the attribute value + salt.
  /// For age: Poseidon(birth_year, salt)
  /// For employment: Poseidon(employee_id, salt) — or Merkle leaf
  /// For rate_limit: Poseidon(auth_count, salt, month_key)
  commitment      String
  /// Salt used in the commitment (hex). Needed to generate ZK proofs.
  /// Stored encrypted with the tenant DEK (never plaintext at rest).
  salt            String
  /// The actual attribute value (encrypted, for audit/verification).
  /// For age: birth_year (e.g., 1990)
  /// For employment: employee_id
  /// For rate_limit: auth_count
  /// Encrypted with tenant DEK (AES-256-GCM).
  encryptedValue  String
  /// IV for the encrypted value (hex).
  iv              String
  /// Auth tag for the encrypted value (hex).
  authTag         String
  /// Whether this credential is active (can be used for proofs).
  active          Boolean  @default(true)
  /// When the credential expires (null = never).
  expiresAt       DateTime?
  /// Who issued the credential (admin user ID).
  issuedBy        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, externalUserId])
  @@index([tenantId, attributeType])
  @@index([active])
}
