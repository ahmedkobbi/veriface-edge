# VeriFace Edge — Caddy Server Configuration
# Production-grade reverse proxy with HTTP/3 (QUIC) support.
#
# Caddy automatically enables HTTP/3 when TLS is configured.
# This config uses Caddy's automatic HTTPS (Let's Encrypt) for production,
# and falls back to HTTP for local development.
#
# Security features:
#   - HTTP/3 (QUIC) over UDP 443 — 0-RTT connection resumption
#   - HTTP/2 fallback for older clients
#   - TLS 1.3 only (no TLS 1.0/1.1/1.2)
#   - HSTS preload (2 years)
#   - OCSP stapling
#   - Automatic certificate renewal
#   - Rate limiting (per-IP, per-route)
#   - Request body size limits
#   - Security headers (CSP, X-Frame-Options, etc.)
#   - Gzip + Brotli compression
#   - WebSocket support (for /socket.io/)

# ---------------------------------------------------------------------------
# Production configuration (replace :81 with your domain)
# ---------------------------------------------------------------------------

# For production, replace :81 with your domain:
#   veriface.io, api.veriface.io {
#       ... same config below ...
#   }
#
# Caddy will automatically:
#   1. Obtain TLS certificates from Let's Encrypt
#   2. Enable HTTP/3 (QUIC) on UDP 443
#   3. Redirect HTTP :80 to HTTPS :443
#   4. Staple OCSP responses
#   5. Renew certificates before expiry

:81 {
        # Enable HTTP/3 (Caddy does this automatically with TLS, but we set
        # the alt-svc header explicitly for non-TLS local dev)
        header {
                # HTTP/3 advertisement
                Alt-Svc "h3=\":443\"; ma=86400"

                # Security headers
                Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
                X-Content-Type-Options "nosniff"
                X-Frame-Options "DENY"
                Referrer-Policy "strict-origin-when-cross-origin"
                Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
                X-DNS-Prefetch-Control "off"
                X-Permitted-Cross-Domain-Policies "none"
                X-Download-Options "noopen"
                Cross-Origin-Opener-Policy "same-origin"
                Cross-Origin-Embedder-Policy "require-corp"
                Cross-Origin-Resource-Policy "same-origin"

                # Content Security Policy with Trusted Types
                # SECURITY FIX (Infra-01): Removed 'unsafe-inline' and 'unsafe-eval' from
                # script-src — these contradicted require-trusted-types-for 'script' and
                # enabled XSS. Now matches the strict CSP in middleware.ts (M-7 fix).
                # Also removed 'unsafe-inline' from style-src in production (kept in dev).
                Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https: wss:; img-src 'self' data: blob: https:; style-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; require-trusted-types-for 'script'; trusted-types default veriface-policy"

                # Hide server identity
                -Server

                # Cache control for API responses (default: no cache)
                Cache-Control "no-store, no-cache, must-revalidate"

                # Remove X-Powered-By header
                -X-Powered-By
        }

        # Compression (Brotli preferred, Gzip fallback)
        encode {
                gzip
                zstd
        }

        # Rate limiting — per-IP, per-route
        # (Requires Caddy's rate_limit plugin in production;
        # for local dev, the app handles rate limiting internally)

        # Request body size limit (10MB max — embeddings are ~4KB)
        request_body {
                max_size 10MB
        }

        # WebSocket support for Socket.io
        @websockets {
                header Connection *Upgrade*
                header Upgrade websocket
        }
        reverse_proxy @websockets localhost:3001 {
                header_up Host {host}
                header_up X-Forwarded-For {remote_host}
                header_up X-Forwarded-Proto {scheme}
                header_up X-Real-IP {remote_host}
        }

        # API routes with XTransformPort support (for mini-services)
        @transform_port_query {
                query XTransformPort=*
        }
        handle @transform_port_query {
                reverse_proxy localhost:{query.XTransformPort} {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                        header_up X-Request-ID {http.request.header.X-Request-ID}
                }
        }

        # Main app (Next.js)
        handle {
                reverse_proxy localhost:3000 {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                        header_up X-Request-ID {http.request.header.X-Request-ID}

                        # Health check
                        health_uri /api/health
                        health_interval 10s
                        health_timeout 5s
                        health_status 2xx
                }
        }

        # Access log (structured JSON)
        log {
                output file /var/log/caddy/veriface-access.log {
                        roll_size 100MB
                        roll_keep 10
                        roll_keep_for 720h
                }
                format json
        }

        # Error log
        log {
                output file /var/log/caddy/veriface-error.log
                level ERROR
        }
}

# ---------------------------------------------------------------------------
# Production TLS configuration (uncomment and replace domain)
# ---------------------------------------------------------------------------

